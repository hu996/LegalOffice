@model LegalOffice.Application.ViewModels.ReportLawyerVM
@{
    ViewData["Title"] = "تقارير المحامين";
}

<div class="glass-card p-4 mb-4">
    <h2 class="mb-1">تقارير المحامين</h2>
    <div class="text-muted mb-3">تعرف على عدد القضايا لكل محامٍ مع الفلاتر الاختيارية.</div>
    <partial name="_Filters" model="Model.Filters" />
</div>

<div class="card-kpi p-3 mb-4">
    <div class="kpi-label">إجمالي القضايا في التقرير</div>
    <div class="kpi-value">@Model.TotalCases</div>
</div>

<div class="glass-card p-4">
    <table class="table table-hover align-middle mb-0">
        <thead>
        <tr>
            <th>المحامي</th>
            <th>إجمالي القضايا</th>
            <th>المفتوحة</th>
            <th>المغلقة</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Rows)
        {
            <tr>
                <td>@item.LawyerName</td>
                <td>@item.CasesCount</td>
                <td>@item.OpenCases</td>
                <td>@item.ClosedCases</td>
            </tr>
        }
        </tbody>
    </table>
</div>
