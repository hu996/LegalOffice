@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - نظام الإدارة</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell d-flex align-items-center justify-content-center">
        <div class="auth-panel">
            <section class="auth-hero">
                <div>
                    <div class="auth-hero-badge mb-4">
                        <span class="dot" style="width:10px;height:10px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--primary));display:inline-block;"></span>
                        نظام إدارة متكامل
                    </div>
                    <h1 class="auth-hero-title">إدارة المستخدمين والبيانات والصلاحيات في مكان واحد</h1>
                    <p class="auth-hero-text mb-4">
                        واجهة دخول بسيطة وآمنة للوصول إلى أدوات النظام ومتابعة البيانات والإشعارات والإعدادات بشكل منظم.
                    </p>
                </div>
                <img src="~/images/law-hero.svg" class="auth-hero-illustration" alt="صورة قانونية توضيحية" />
            </section>

            <section class="auth-form-side">
                <div class="auth-card">
                    <div class="text-center mb-4">
                        <img src="~/images/law-logo.svg" class="brand-logo mb-3" alt="مكتب المحاماة" />
                        <h1 class="h3 mb-1">تسجيل الدخول</h1>
                        <div class="text-muted">أدخل بياناتك للوصول إلى النظام</div>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form method="post" class="d-grid gap-3">
                        <div>
                            <label class="form-label">البريد الإلكتروني أو اسم المستخدم</label>
                            <input name="email" class="form-control" placeholder="admin@legal.local" value="admin@legal.local" />
                        </div>
                        <div>
                            <label class="form-label">كلمة المرور</label>
                            <input name="password" type="password" class="form-control" placeholder="123456" value="123456" />
                        </div>
                        <button class="btn btn-gold w-100">دخول</button>
                    </form>
                </div>
            </section>
        </div>
    </div>
</body>
</html>
