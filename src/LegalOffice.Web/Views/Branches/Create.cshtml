@model LegalOffice.Application.ViewModels.BranchEditVM
@{
    ViewData["Title"] = "إضافة فرع";
}

<h3 class="mb-3">إضافة فرع</h3>
<form asp-action="Create" method="post" class="card card-body">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="NameAr" class="form-label"></label>
        <input asp-for="NameAr" class="form-control" />
        <span asp-validation-for="NameAr" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ManagerUserId" class="form-label"></label>
        <select asp-for="ManagerUserId" asp-items="Model.Managers" class="form-select">
            <option value="">-- بدون مدير --</option>
        </select>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">حفظ</button>
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
    </div>
</form>
