@model LegalOffice.Application.ViewModels.MessageSendVM
@{
    ViewData["Title"] = "إرسال رسالة";
}

<div class="glass-card p-4">
    <h2 class="mb-1">إرسال رسالة للعميل</h2>
    <div class="text-muted mb-4">يمكن إرسال تذكير أو تحديث حالة أو طلب مستندات من نفس شاشة القضية.</div>

    <form method="post" class="row g-3">
        <input asp-for="CaseId" type="hidden" />
        <input asp-for="ClientId" type="hidden" />
        <div class="col-md-4">
            <label class="form-label">القناة</label>
            <select asp-for="Channel" class="form-select">
                <option>WhatsApp</option>
                <option>SMS</option>
            </select>
        </div>
        <div class="col-md-8">
            <label class="form-label">رقم الهاتف</label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>
        <div class="col-12">
            <label class="form-label">الرسالة</label>
            <textarea asp-for="MessageText" class="form-control" rows="6"></textarea>
        </div>
        <div class="col-12 d-flex gap-2">
            <button class="btn btn-gold">إرسال</button>
            <a asp-controller="Cases" asp-action="Details" asp-route-id="@Model.CaseId" class="btn btn-outline-secondary">رجوع</a>
        </div>
    </form>
</div>
