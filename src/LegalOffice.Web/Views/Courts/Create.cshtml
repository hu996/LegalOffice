@model LegalOffice.Domain.Entities.Lookup
@{
    ViewData["Title"] = "إضافة محكمة";
}

<div class="glass-card p-4">
    <h2 class="mb-1">إضافة محكمة جديدة</h2>
    <div class="text-muted mb-4">أضف المحكمة مرة واحدة لتظهر تلقائيًا في القضايا.</div>

    <form method="post" class="row g-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="Type" type="hidden" />
        <div class="col-md-6">
            <label class="form-label">اسم المحكمة بالعربي</label>
            <input asp-for="NameAr" class="form-control" />
            <span asp-validation-for="NameAr" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">الاسم الإنجليزي</label>
            <input asp-for="NameEn" class="form-control" />
            <span asp-validation-for="NameEn" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">نشطة</label>
            </div>
        </div>
        <div class="col-12 d-flex gap-2">
            <button class="btn btn-gold">حفظ</button>
            <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
