@model LegalOffice.Application.ViewModels.DocumentCreateEditVM
@{
    ViewData["Title"] = "إضافة مستند";
}

<div class="glass-card p-4">
    <h2 class="mb-1">إضافة مستند للقضية</h2>
    <div class="text-muted mb-4">ارفع المستند وحدد نوعه عشان يبان مرتب داخل ملف القضية.</div>

    <form method="post" enctype="multipart/form-data" class="row g-3">
        <input asp-for="CaseId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-md-4">
            <label class="form-label">نوع المستند</label>
            <select asp-for="DocumentTypeId" asp-items="Model.DocumentTypes" class="form-select"></select>
            <span asp-validation-for="DocumentTypeId" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Files" class="form-label"></label>
            <input asp-for="Files" type="file" class="form-control" multiple accept="image/*,.pdf,.doc,.docx" />
            <small class="text-muted">يمكنك رفع أكثر من ملف أو صورة في نفس العملية.</small>
            <span asp-validation-for="Files" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label class="form-label">ملاحظات</label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        </div>

        <div class="col-12 d-flex gap-2">
            <button class="btn btn-gold">حفظ المستند</button>
            <a asp-controller="Cases" asp-action="Details" asp-route-id="@Model.CaseId" class="btn btn-outline-secondary">رجوع</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
