@model LegalOffice.Application.ViewModels.ConflictCheckVM
@{
    ViewData["Title"] = "فحص تعارض جديد";
}

<h3 class="mb-3">فحص تعارض جديد</h3>
<form asp-action="Create" method="post" class="card card-body">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="CaseTypeId" class="form-label"></label>
            <select asp-for="CaseTypeId" asp-items="Model.CaseTypes" class="form-select" id="conflictCaseTypeId">
                <option value="">-- اختر نوع القضية --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="ClientName" class="form-label"></label>
            <input asp-for="ClientName" class="form-control" />
            <span asp-validation-for="ClientName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="OpponentName" class="form-label"></label>
            <input asp-for="OpponentName" class="form-control" />
            <span asp-validation-for="OpponentName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="NationalId" class="form-label"></label>
            <input asp-for="NationalId" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="CaseId" class="form-label"></label>
            <select asp-for="CaseId" asp-items="Model.Cases" class="form-select" id="conflictCaseId">
                <option value="">-- بدون قضية --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="ResultStatusLookupId" class="form-label"></label>
            <select asp-for="ResultStatusLookupId" asp-items="Model.Results" class="form-select">
                <option value="">-- النظام يحدد تلقائياً --</option>
            </select>
        </div>
    </div>
    <div class="mt-3 mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">حفظ الفحص</button>
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/case-filter.js" asp-append-version="true"></script>
    <script>
        window.initCaseTypeDependentSelect({
            sourceSelectId: 'conflictCaseTypeId',
            targetSelectId: 'conflictCaseId',
            endpoint: '@Url.Action("EligibleCases", "Cases")',
            placeholder: 'بدون قضية'
        });
    </script>
}
