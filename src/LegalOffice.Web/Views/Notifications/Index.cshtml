@model LegalOffice.Web.Controllers.NotificationCenterVM
@{
    ViewData["Title"] = "الإشعارات";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="eyebrow">مركز التنبيهات</div>
        <h2 class="mb-1">الإشعارات</h2>
        <div class="text-muted">كل الإشعارات المرتبطة بتكليف القضايا تظهر هنا.</div>
    </div>
    <div class="badge rounded-pill text-bg-light border px-3 py-2">غير مقروء: @Model.UnreadCount</div>
</div>

<div class="glass-card p-3 p-md-4">
    @if (Model.Items.Count == 0)
    {
        <div class="text-muted">لا توجد إشعارات حتى الآن.</div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var item in Model.Items)
            {
                <a asp-controller="Notifications" asp-action="Open" asp-route-id="@item.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-3 @(item.IsRead ? "" : "bg-light")">
                    <div>
                        <div class="fw-semibold">@item.Title</div>
                        <div class="text-muted small">@item.Body</div>
                    </div>
                    <div class="text-muted small text-nowrap">@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                </a>
            }
        </div>
    }
</div>
