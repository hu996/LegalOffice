@model LegalOffice.Application.ViewModels.TreasuryDashboardVM
@{
    ViewData["Title"] = "الخزنة";
}

<div class="page-header">
    <div>
        <h1 class="h3 mb-1">@Model.TreasuryName</h1>
        <p class="text-muted mb-0">متابعة رصيد الخزنة وحركاتها.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">إضافة حركة</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3">
            <div class="text-muted">الرصيد الحالي</div>
            <div class="h3 mb-0">@Model.CurrentBalance.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <div class="text-muted">إجمالي الإيراد</div>
            <div class="h3 mb-0 text-success">@Model.TotalIncome.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <div class="text-muted">إجمالي الصرف</div>
            <div class="h3 mb-0 text-danger">@Model.TotalExpense.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>التاريخ</th>
                <th>النوع</th>
                <th>المبلغ</th>
                <th>القضية</th>
                <th>ملاحظات</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Transactions)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.TransactionDate.ToString("yyyy/MM/dd HH:mm")</td>
                <td>@item.TransactionTypeName</td>
                <td>@item.Amount.ToString("N2")</td>
                <td>@item.CaseNumber</td>
                <td>@item.Notes</td>
            </tr>
        }
        </tbody>
    </table>
</div>
