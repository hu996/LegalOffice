@model LegalOffice.Application.ViewModels.TreasuryTransactionVM
@{
    ViewData["Title"] = "إضافة حركة خزنة";
}

<h1 class="h3 mb-4">إضافة حركة خزنة</h1>

<form method="post" class="card p-3">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="CaseTypeId" class="form-label"></label>
            <select asp-for="CaseTypeId" asp-items="Model.CaseTypes" class="form-select" id="treasuryCaseTypeId">
                <option value="">-- اختر نوع القضية --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="TreasuryId" class="form-label"></label>
            <select asp-for="TreasuryId" asp-items="Model.Treasuries" class="form-select"></select>
            <span asp-validation-for="TreasuryId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="TransactionTypeLookupId" class="form-label"></label>
            <select asp-for="TransactionTypeLookupId" asp-items="Model.TransactionTypes" class="form-select">
                <option value="">-- اختر النوع --</option>
            </select>
            <span asp-validation-for="TransactionTypeLookupId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="TransactionDate" class="form-label"></label>
            <input asp-for="TransactionDate" type="datetime-local" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="CaseId" class="form-label"></label>
            <select asp-for="CaseId" asp-items="Model.Cases" class="form-select" id="treasuryCaseId">
                <option value="">-- اختياري --</option>
            </select>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        </div>
    </div>
    <div class="mt-4">
        <button class="btn btn-primary">حفظ</button>
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/case-filter.js" asp-append-version="true"></script>
    <script>
        window.initCaseTypeDependentSelect({
            sourceSelectId: 'treasuryCaseTypeId',
            targetSelectId: 'treasuryCaseId',
            endpoint: '@Url.Action("EligibleCases", "Cases")',
            placeholder: 'اختياري'
        });
    </script>
}
