@model IReadOnlyList<string>
@{
    ViewData["Title"] = "الصلاحيات";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="eyebrow">إدارة الصلاحيات</div>
        <h2 class="mb-1">الأدوار</h2>
        <div class="text-muted">اختار أي Role وعدّل الصلاحيات اللي شايفها داخل السيستم.</div>
    </div>
</div>

<div class="glass-card p-3 p-md-4">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>الـ Role</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model)
            {
                <tr>
                    <td>@role</td>
                    <td class="text-nowrap">
                        <a asp-action="EditRole" asp-route-roleName="@role" class="btn btn-sm btn-outline-primary">تعديل الصلاحيات</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
