@model LegalOffice.Application.ViewModels.RolePermissionEditVM
@{
    ViewData["Title"] = "تعديل صلاحيات";
}

<div class="glass-card p-4">
    <h2 class="mb-1">تعديل صلاحيات @Model.RoleName</h2>
    <div class="text-muted mb-4">حدد الشاشات/الأفعال اللي مسموح للـ Role ده يشوفها.</div>

    <form method="post" class="row g-3">
        <input asp-for="RoleName" type="hidden" />
        <div class="col-12">
            <div class="row g-3">
                @foreach (var permission in Model.Permissions)
                {
                    var selected = Model.SelectedPermissionIds.Contains(permission.Id);
                    <div class="col-md-6 col-lg-4">
                        <label class="permission-chip @(selected ? "selected" : "")">
                            <input type="checkbox" name="SelectedPermissionIds" value="@permission.Id" @(selected ? "checked" : "") />
                            <div>
                                <div class="fw-bold">@permission.NameAr</div>
                                <div class="small text-muted">@permission.Controller/@permission.Action</div>
                            </div>
                        </label>
                    </div>
                }
            </div>
        </div>
        <div class="col-12 d-flex gap-2">
            <button class="btn btn-gold">حفظ الصلاحيات</button>
            <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
        </div>
    </form>
</div>
