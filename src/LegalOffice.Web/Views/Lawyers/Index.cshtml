@model LegalOffice.Application.ViewModels.PagedResult<LegalOffice.Domain.Entities.Lawyer>
@{
    ViewData["Title"] = "المحامون";
    var search = ViewBag.Search as string;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="eyebrow">فريق العمل</div>
        <h2 class="mb-1">المحامون</h2>
        <div class="text-muted">إدارة المحامين وربطهم بحسابات الدخول والصلاحيات.</div>
    </div>
    <a class="btn btn-gold" asp-action="Create">إضافة محامي</a>
</div>

<div class="glass-card p-3 p-md-4 mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-10">
            <input name="search" class="form-control" placeholder="ابحث بالاسم أو البريد أو الوظيفة..." value="@search" />
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-outline-primary">بحث</button>
        </div>
    </form>
</div>

<div class="table-responsive glass-card p-3 p-md-4">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>الاسم</th>
                <th>البريد</th>
                <th>الوظيفة</th>
                <th>التخصصات</th>
                <th>الحساب</th>
                <th>الحالة</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lawyer in Model.Items)
            {
                <tr>
                    <td>@lawyer.FullName</td>
                    <td>@lawyer.Email</td>
                    <td>@lawyer.JobTitle</td>
                    <td>@string.Join("، ", lawyer.Specialties.Select(x => x.CaseType.NameAr))</td>
                    <td>@(string.IsNullOrWhiteSpace(lawyer.UserId) ? "غير مرتبط" : "مرتبط")</td>
                    <td><span class="badge text-bg-light border">@(lawyer.IsActive ? "نشط" : "متوقف")</span></td>
                    <td><a asp-action="Edit" asp-route-id="@lawyer.Id" class="btn btn-sm btn-outline-secondary">تعديل</a></td>
                </tr>
            }
        </tbody>
    </table>

    @{
        var pager = new LegalOffice.Application.ViewModels.PaginationVM
        {
            ControllerName = "Lawyers",
            ActionName = "Index",
            Page = Model.Page,
            TotalPages = Model.TotalPages,
            RouteValues = new Dictionary<string, object?>
            {
                ["search"] = search,
                ["pageSize"] = Model.PageSize
            }
        };
    }
    <partial name="_Pagination" model="pager" />
</div>
