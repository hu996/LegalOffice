@model LegalOffice.Domain.Entities.MessageTemplate
@{
    ViewData["Title"] = "إضافة قالب";
}

<h1 class="h3 mb-4">إضافة قالب</h1>

<form method="post" class="card p-3">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Channel" class="form-label"></label>
            <input asp-for="Channel" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Body" class="form-label"></label>
            <textarea asp-for="Body" class="form-control" rows="6"></textarea>
        </div>
        <div class="col-12 form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>
    <div class="mt-4">
        <button class="btn btn-primary">حفظ</button>
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
    </div>
</form>
