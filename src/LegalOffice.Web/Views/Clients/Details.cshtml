@model LegalOffice.Domain.Entities.Client
@{
    ViewData["Title"] = "تفاصيل الموكل";
}

<div class="glass-card p-4 mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <div class="eyebrow">بيانات الموكل</div>
            <h2 class="mb-1">@Model.FullName</h2>
            <div class="text-muted">عدد القضايا: @Model.Cases.Count</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gold">تعديل</a>
            <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-4"><div class="p-3 rounded-4 bg-light border">الهاتف: @Model.Phone</div></div>
        <div class="col-md-4"><div class="p-3 rounded-4 bg-light border">واتساب: @Model.WhatsAppPhone</div></div>
        <div class="col-md-4"><div class="p-3 rounded-4 bg-light border">البريد: @Model.Email</div></div>
        <div class="col-md-4"><div class="p-3 rounded-4 bg-light border">الرقم القومي: @Model.NationalId</div></div>
        <div class="col-md-4"><div class="p-3 rounded-4 bg-light border">النوع: @Model.ClientType</div></div>
        <div class="col-12"><div class="p-3 rounded-4 bg-light border">العنوان: @Model.Address</div></div>
    </div>
</div>

<div class="glass-card p-4">
        <h4 class="mb-3">القضايا المرتبطة</h4>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>رقم القضية</th>
                    <th>العنوان</th>
                    <th>الحالة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Cases.OrderByDescending(x => x.Id))
                {
                    <tr>
                        <td>@item.CaseNumber</td>
                        <td>@item.Title</td>
                        <td>@item.CaseStatus.NameAr</td>
                        <td><a asp-controller="Cases" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">فتح</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
