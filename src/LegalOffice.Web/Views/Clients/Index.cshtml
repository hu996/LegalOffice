@model LegalOffice.Application.ViewModels.PagedResult<LegalOffice.Domain.Entities.Client>
@{
    ViewData["Title"] = "الموكلين";
    var search = ViewBag.Search as string;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="eyebrow">بيانات الموكلين</div>
        <h2 class="mb-1">الموكلين</h2>
        <div class="text-muted">إدارة بيانات العميل وربطها بالقضايا.</div>
    </div>
    <a class="btn btn-gold" asp-action="Create">إضافة عميل</a>
</div>

<div class="glass-card p-3 p-md-4 mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-10">
            <input name="search" class="form-control" placeholder="ابحث بالاسم أو الهاتف..." value="@search" />
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-outline-primary">بحث</button>
        </div>
    </form>
</div>

<div class="table-responsive glass-card p-3 p-md-4">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>الاسم</th>
                <th>الهاتف</th>
                <th>البريد</th>
                <th>النوع</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model.Items)
            {
                <tr>
                    <td>@client.FullName</td>
                    <td>@client.Phone</td>
                    <td>@client.Email</td>
                    <td>@client.ClientType</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-outline-secondary">تفاصيل</a>
                        <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @{
        var pager = new LegalOffice.Application.ViewModels.PaginationVM
        {
            ControllerName = "Clients",
            ActionName = "Index",
            Page = Model.Page,
            TotalPages = Model.TotalPages,
            RouteValues = new Dictionary<string, object?>
            {
                ["search"] = search,
                ["pageSize"] = Model.PageSize
            }
        };
    }
    <partial name="_Pagination" model="pager" />
</div>
