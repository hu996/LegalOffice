@model IEnumerable<LegalOffice.Domain.Entities.ExecutionCase>
@{
    ViewData["Title"] = "ملفات التنفيذ";
}

<div class="page-header">
    <div>
        <h1 class="h3 mb-1">ملفات التنفيذ</h1>
        <p class="text-muted mb-0">متابعة التنفيذ المرتبط بالأحكام.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">إضافة ملف تنفيذ</a>
</div>

<form class="row g-2 mb-3" method="get">
    <div class="col-md-8">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="ابحث برقم القضية أو مأمور التنفيذ" />
    </div>
    <div class="col-md-4">
        <button class="btn btn-outline-primary w-100">بحث</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>القضية</th>
                <th>الحالة</th>
                <th>مأمور التنفيذ</th>
                <th>تاريخ البداية</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Judgment?.Case?.CaseNumber</td>
                <td>@item.ExecutionStatusLookup?.NameAr</td>
                <td>@item.ExecutionOfficer</td>
                <td>@item.StartDate.ToString("yyyy/MM/dd")</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">تعديل</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
