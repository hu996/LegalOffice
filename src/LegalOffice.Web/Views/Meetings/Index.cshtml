@model IEnumerable<LegalOffice.Domain.Entities.Meeting>
@{
    ViewData["Title"] = "الاجتماعات";
}

<div class="page-header">
    <div>
        <h1 class="h3 mb-1">الاجتماعات</h1>
        <p class="text-muted mb-0">متابعة الاجتماعات الداخلية والخارجية.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">إضافة اجتماع</a>
</div>

<form class="row g-2 mb-3" method="get">
    <div class="col-md-8">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="ابحث بالموضوع أو اسم العميل أو القضية أو المسؤول" />
    </div>
    <div class="col-md-4">
        <button class="btn btn-outline-primary w-100">بحث</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>الموضوع</th>
                <th>العميل</th>
                <th>القضية</th>
                <th>المسؤول</th>
                <th>التاريخ</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Subject</td>
                <td>@item.Client?.FullName</td>
                <td>@item.Case?.CaseNumber</td>
                <td>@item.AssignedUser?.FullName</td>
                <td>@item.MeetingDate.ToString("yyyy/MM/dd HH:mm")</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">تعديل</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
