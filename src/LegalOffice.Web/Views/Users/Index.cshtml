@model LegalOffice.Application.ViewModels.PagedResult<LegalOffice.Application.ViewModels.UserIndexItemVM>
@{
    ViewData["Title"] = "المستخدمين";
    var search = ViewBag.Search as string;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="eyebrow">إدارة الحسابات</div>
        <h2 class="mb-1">المستخدمين</h2>
        <div class="text-muted">إنشاء وتعديل المستخدمين وربطهم بالتصنيف والإدارة المناسبة.</div>
    </div>
    <a class="btn btn-gold" asp-action="Create">إضافة مستخدم</a>
</div>

<div class="glass-card p-3 p-md-4 mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-10">
            <input name="search" class="form-control" placeholder="ابحث بالاسم أو الإيميل..." value="@search" />
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-outline-primary">بحث</button>
        </div>
    </form>
</div>

<div class="table-responsive glass-card p-3 p-md-4">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>الاسم</th>
                <th>الإيميل</th>
                <th>الدور</th>
                <th>النوع</th>
                <th>الإدارة</th>
                <th>المحامي</th>
                <th>الحالة</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.RoleName</td>
                <td>@item.UserTypeName</td>
                <td>@item.DepartmentName</td>
                <td>@item.LawyerName</td>
                <td class="text-nowrap">
                    <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "نشط" : "غير نشط")</span>
                </td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                    <form asp-action="ResetPassword" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('هل تريد إعادة تعيين كلمة المرور لهذا المستخدم؟');">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-warning">إعادة تعيين الباسورد</button>
                    </form>
                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-secondary">@((item.IsActive) ? "تعطيل" : "تفعيل")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @{
        var pager = new LegalOffice.Application.ViewModels.PaginationVM
        {
            ControllerName = "Users",
            ActionName = "Index",
            Page = Model.Page,
            TotalPages = Model.TotalPages,
            RouteValues = new Dictionary<string, object?>
            {
                ["search"] = search,
                ["pageSize"] = Model.PageSize
            }
        };
    }
    <partial name="_Pagination" model="pager" />
</div>
