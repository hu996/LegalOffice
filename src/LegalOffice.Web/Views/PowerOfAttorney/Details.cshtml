@model LegalOffice.Domain.Entities.PowerOfAttorney
@{
    ViewData["Title"] = "تفاصيل التوكيل";
    var attachments = LegalOffice.Web.Controllers.PowerOfAttorneyController.GetAttachmentPaths(Model.FilePath);
}

<div class="card card-body">
    <h3 class="mb-3">تفاصيل التوكيل</h3>

    <dl class="row mb-0">
        <dt class="col-sm-3">رقم التوكيل</dt>
        <dd class="col-sm-9">@Model.PowerNumber</dd>

        <dt class="col-sm-3">العميل</dt>
        <dd class="col-sm-9">@Model.Client?.FullName</dd>

        <dt class="col-sm-3">النوع</dt>
        <dd class="col-sm-9">@Model.TypeLookup?.NameAr</dd>

        <dt class="col-sm-3">الحالة</dt>
        <dd class="col-sm-9">@Model.StatusLookup?.NameAr</dd>

        <dt class="col-sm-3">تاريخ الإصدار</dt>
        <dd class="col-sm-9">@Model.IssueDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">تاريخ الانتهاء</dt>
        <dd class="col-sm-9">@Model.ExpiryDate?.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">المكتب</dt>
        <dd class="col-sm-9">@Model.RegistrationOffice</dd>

        <dt class="col-sm-3">ملاحظات</dt>
        <dd class="col-sm-9">@Model.Notes</dd>
    </dl>

    <hr />

    <h5 class="mb-3">المرفقات</h5>
    @if (attachments.Count == 0)
    {
        <div class="text-muted">لا توجد مرفقات.</div>
    }
    else
    {
        <ul class="list-group">
            @foreach (var attachment in attachments)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a href="@Url.Content("~/" + attachment)" target="_blank">@LegalOffice.Web.Controllers.PowerOfAttorneyController.GetAttachmentName(attachment)</a>
                </li>
            }
        </ul>
    }

    <div class="d-flex gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a>
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
    </div>
</div>
